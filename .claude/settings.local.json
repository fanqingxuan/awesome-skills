      "Bash(cd /tmp && rm -rf test_dir && mkdir test_dir && tar -xf php.tar.gz -C test_dir && ls -la test_dir/)",
      "Bash(cd /tmp && rm -f php8.4.tar.gz && curl -sI \"https://download.workerman.net/php/php-8.4-mac-x86_64.tar.gz\" | grep HTTP && echo \"---\" && curl -sL \"https://download.workerman.net/php/php-8.4-mac-x86_64.tar.gz\" -o php8.4.tar.gz && file php8.4.tar.gz && tar -tvf php8.4.tar.gz 2>&1 | head -3)",
